<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="RadioButton">

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="RadioButton">

                    <Border x:Name="Borde" Background="{DynamicResource Background_Primario}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="10" BorderThickness="0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" ShadowDepth="10" BlurRadius="10"/>

                        </Border.Effect>

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="Borde" Property="Effect">
                                
                                <Setter.Value>
                                    
                                    <DropShadowEffect Color="Black" ShadowDepth="5" BlurRadius="10" />
                                    
                                </Setter.Value>
                                
                            </Setter>

                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            
                            <Setter TargetName="Borde" Property="Effect">
                                
                                <Setter.Value>
                                    
                                    <DropShadowEffect Color="Black" ShadowDepth="5" BlurRadius="10" />
                                    
                                </Setter.Value>
                                
                            </Setter>
                            
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>