<Application x:Class="CatálogoDeProductos.App"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:v="clr-namespace:CatálogoDeProductos.Views"
         xmlns:vm="clr-namespace:CatálogoDeProductos.ViewModels"
         xmlns:local="clr-namespace:CatálogoDeProductos">
    <Application.Resources>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type vm:MainViewModel}">
                <v:MainView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}">
                <v:ConfiguracionView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CategoriaViewModel}">
                <v:CategoriasView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductoViewModel}">
                <v:ProductosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InicioViewModel}">
                <v:InicioView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GraficosViewModel}">
                <v:GraficosView/>
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
